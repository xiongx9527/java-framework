            <scope>compile</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-store-embedding</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>


		<dependency>
			<groupId>com.xiongx9527.fw.plus</groupId>
			<artifactId>fw-plus-dify</artifactId>
			<scope>compile</scope>
			<optional>true</optional>
