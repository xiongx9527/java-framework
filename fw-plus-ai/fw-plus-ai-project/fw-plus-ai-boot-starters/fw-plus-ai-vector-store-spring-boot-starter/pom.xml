<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xiongx9527.fw.plus.ai</groupId>
        <artifactId>fw-plus-ai-boot-starters</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>fw-plus-ai-vector-store-spring-boot-starter</artifactId>
    <name>fw-plus-ai-vector-store-spring-boot-starter</name>
    <description>
        向量库 Spring Boot Starter：自动装配框架自研的 VectorStorePort（Qdrant / Milvus / Weaviate /
        Redis / PgVector / Elasticsearch），未配置时暴露 configured()=false 的占位端口，
        并随 Actuator 提供 vectorStore 健康检查。
    </description>

    <properties>
        <main.basedir>${basedir}/../../..</main.basedir>
    </properties>

    <dependencies>
        <!-- 基础 Spring Boot Starter：随 Starter 传递，提供自动配置与容器能力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 自动配置类（携带 VectorStoreAutoConfiguration / VectorStoreHealthConfiguration 与 SPI 注册） -->
        <dependency>
            <groupId>com.xiongx9527.fw.plus.ai</groupId>
            <artifactId>fw-plus-ai-boot-autoconfigure</artifactId>
        </dependency>

        <!-- 向量库原子实现：在 autoconfigure 中是 optional 不传递，starter 必须显式携带，
             否则消费方启动内省配置类即 NoClassDefFoundError -->
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-native</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Actuator（健康检查可选，按 classpath 条件装配；不强制消费方引入） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Configuration Processor (for IDE auto-completion) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
