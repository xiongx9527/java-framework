.DS_Store
node_modules
dist/
yarn.lock
pnpm-lock.yaml
lerna-debug.log
packages/design-core/bundle-deps
designer-demo/bundle-deps

# TinyEngine source package; the parent Maven starters .gitignore has a broad build/ rule.
!packages/build/
!packages/build/**
packages/build/**/dist/
packages/build/**/node_modules/

# local env files
.env.local
.env.*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
tmp
temp
__pycache__

# .claude/skills is a generated link to .agents/skills (see scripts/link-skills.js)
.claude/skills
/test/
