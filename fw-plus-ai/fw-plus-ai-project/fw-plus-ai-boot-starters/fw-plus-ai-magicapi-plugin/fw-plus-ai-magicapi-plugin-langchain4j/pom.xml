<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xiongx9527.fw.plus.ai</groupId>
        <artifactId>fw-plus-ai-magicapi-plugin</artifactId>
        <version>${revision}</version>
    </parent>
    <packaging>pom</packaging>

    <artifactId>fw-plus-ai-magicapi-plugin-langchain4j</artifactId>

    <modules>
        <module>fw-plus-ai-magicapi-plugin-langchain4j-chat-model</module>
        <module>fw-plus-ai-magicapi-plugin-langchain4j-streaming-chat-model</module>
        <module>fw-plus-ai-magicapi-plugin-langchain4j-language-model</module>
        <module>fw-plus-ai-magicapi-plugin-langchain4j-streaming-language-model</module>
        <module>fw-plus-ai-magicapi-plugin-langchain4j-embedding-model</module>
        <module>fw-plus-ai-magicapi-plugin-langchain4j-embedding-store</module>
        <module>fw-plus-ai-magicapi-plugin-langchain4j-tokenizer</module>
        <module>fw-plus-ai-magicapi-plugin-langchain4j-scoring-model</module>
        <module>fw-plus-ai-magicapi-plugin-langchain4j-mcp-client</module>
        <module>fw-plus-ai-magicapi-plugin-langchain4j-agentic-script</module>
        <module>fw-plus-ai-magicapi-plugin-langchain4j-skill</module>
    </modules>

    <properties>
        <main.basedir>${basedir}/../../..</main.basedir>
    </properties>

    <!-- 前端 console 构建（npm install + npm run build + copy dist）的 executions 由
         fw-plus-ai-magicapi-plugin 的 pluginManagement 提供；本工程是 pom 聚合父，
         只做 pluginManagement 传递、不在 <build><plugins> 里启用，避免父工程自身
         没有 src/console 目录却去跑 npm。9 个子工程各自在自己的 pom 里启用，
         行为与 boot 层 fw-plus-magicapi-plugin 的 28 个插件子工程一致。 -->

    <dependencies>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
    </dependencies>

</project>
