      "com.alibaba.druid.sql.dialect.mysql.ast"
    ],
    "sampleSqlGroups": []
  },
  "entries": [],
  "reflectedCandidates": [],
  "parserCoreConsumption": {
    "matrixIsTestFactSource": true,
    "markdownIsTestFactSource": false,
