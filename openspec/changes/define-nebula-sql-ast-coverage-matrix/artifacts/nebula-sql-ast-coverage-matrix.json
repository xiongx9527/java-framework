        "constructs": [
          "INSERT",
          "UPDATE",
          "DELETE",
          "CREATE TABLE",
          "DROP TABLE",
          "SHOW",
          "DESCRIBE"
        ]
      },
      {
        "id": "framework-generated",
        "constructs": [
          "? 参数",
          "IN 参数列表",
          "分页",
          "metadata 探测 SQL",
          "动态 SQL 展开后的条件组合"
        ]
      }
    ]
