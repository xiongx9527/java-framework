<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.18</version>
		<relativePath/>
	</parent>

	<groupId>com.xiongx9527.fw.plus.ai.example</groupId>
	<artifactId>askdata-langchain4j-jdbc-example</artifactId>
	<version>0.1.1-SNAPSHOT</version>

	<properties>
		<java.version>1.8</java.version>
		<fw-plus.version>0.1.1-SNAPSHOT</fw-plus.version>
		<langchain4j.version>0.35.0</langchain4j.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.xiongx9527.fw.plus.ai</groupId>
			<artifactId>fw-plus-ai-askdata-spring-boot-starter</artifactId>
			<version>${fw-plus.version}</version>
		</dependency>
		<dependency>
			<groupId>com.xiongx9527.fw.plus</groupId>
			<artifactId>fw-plus-ai-langchain4j-adapter</artifactId>
			<version>${fw-plus.version}</version>
		</dependency>
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j-open-ai</artifactId>
			<version>${langchain4j.version}</version>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
