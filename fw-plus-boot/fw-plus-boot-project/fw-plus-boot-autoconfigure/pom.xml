            <exclusions>
                <!--
                  pulsar-client 会传递引入 log4j-slf4j-impl，与 Spring Boot 默认的 logback 形成
                  双 SLF4J 绑定：SLF4J 绑到 Log4j，而 Spring Boot 仍按 logback 初始化，
                  LogbackLoggingSystem.getLoggerContext() 直接抛
                  "LoggerFactory is not a Logback LoggerContext but Logback is on the classpath"。
                  本模块的 @SpringBootTest（真实 Servlet 容器）会因此在启动期失败。
                  该依赖为 optional，排除只影响本模块自身 classpath，不会传递给使用方。
                -->
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

