                  形成第二个 SLF4J 绑定（pulsar 那一路的 log4j-slf4j-impl 已另行排除）。
                  保留唯一绑定 logback，否则本模块的 @SpringBootTest 会在启动期抛
                  "LoggerFactory is not a Logback LoggerContext but Logback is on the classpath"。
                  optional 依赖的排除不影响使用方。
                -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
                <!--
                  seata-console 是 Spring Boot 2 时代的控制台构件，传递 javax.servlet-api，
                  会让 magic-api 的 javaee servlet 配置条件也得到满足，与 jakarta 版双注册
                  magicRequestContextHolder（BeanDefinitionOverrideException）。
                  Spring Boot 3 栈只应看到 jakarta.servlet，故排除。
                -->
                <exclusion>
                    <groupId>javax.servlet</groupId>
                    <artifactId>javax.servlet-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>io.seata</groupId>
            <artifactId>seata-spring-boot-starter</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-dify</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-common</artifactId>
        </dependency>
    </dependencies>

</project>
