<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xiongx9527.fw.plus.boot</groupId>
        <artifactId>fw-plus-boot-starters</artifactId>
        <version>${revision}</version>
    </parent>
    <packaging>pom</packaging>
    <modules>
        <module>fw-plus-magicapi-plugin-freemarker</module>
        <module>fw-plus-magicapi-plugin-config</module>
        <module>fw-plus-magicapi-plugin-rocketmq</module>
        <module>fw-plus-magicapi-plugin-rabbitmq</module>
        <module>fw-plus-magicapi-plugin-kafka</module>
        <module>fw-plus-magicapi-plugin-pulsar</module>
        <module>fw-plus-magicapi-plugin-vue3</module>
        <module>fw-plus-magicapi-plugin-druid</module>
        <module>fw-plus-magicapi-plugin-swagger</module>
        <module>fw-plus-magicapi-plugin-admin</module>
        <module>fw-plus-magicapi-plugin-debezium</module>
        <module>fw-plus-magicapi-plugin-db</module>
        <module>fw-plus-magicapi-plugin-redis</module>
        <module>fw-plus-magicapi-plugin-mongo</module>
        <module>fw-plus-magicapi-plugin-s3</module>
        <module>fw-plus-magicapi-plugin-task</module>
        <module>fw-plus-magicapi-plugin-ws</module>
        <module>fw-plus-magicapi-plugin-dtp</module>
        <module>fw-plus-magicapi-plugin-mqtt-server</module>
        <module>fw-plus-magicapi-plugin-influx</module>
        <module>fw-plus-magicapi-plugin-elasticsearch</module>
        <module>fw-plus-magicapi-plugin-satoken</module>
        <module>fw-plus-magicapi-plugin-mqtt-client</module>
        <module>fw-plus-magicapi-plugin-word</module>
        <module>fw-plus-magicapi-plugin-java-entity</module>
        <module>fw-plus-magicapi-plugin-spring-bean</module>
        <module>fw-plus-magicapi-plugin-mybatisplus</module>
        <module>fw-plus-magicapi-plugin-mybatisflex</module>
    </modules>

    <artifactId>fw-plus-magicapi-plugin</artifactId>
    <properties>
        <main.basedir>${basedir}/../../..</main.basedir>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 前端 console 构建（npm install + npm run build），在 prepare-package 阶段执行，mvn compile 不触发前端构建 -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>npm-install</id>
                            <phase>prepare-package</phase>
                            <goals><goal>exec</goal></goals>
                            <configuration>
                                <workingDirectory>${project.basedir}/src/console</workingDirectory>
                                <executable>npm</executable>
                                <arguments>
                                    <argument>install</argument>
                                </arguments>
                            </configuration>
                        </execution>
                        <execution>
                            <id>npm-build</id>
                            <phase>prepare-package</phase>
                            <goals><goal>exec</goal></goals>
                            <configuration>
                                <workingDirectory>${project.basedir}/src/console</workingDirectory>
                                <executable>npm</executable>
                                <arguments>
                                    <argument>run</argument>
                                    <argument>build</argument>
                                </arguments>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!-- 复制前端构建产物到 resources 目录。绑两个阶段：
                     ① process-resources：与 clean-stale-console-assets（initialize）配对。产物模块没有
                        Java 源码，target/classes/magic-editor 是它唯一的产物落点，而 initialize 的清理是
                        无条件执行的。若只靠 ② 重填，`mvn compile` / `mvn test` 走不到 prepare-package，
                        产物会被删掉且不重建（表现为运行期控制台面板 404、xxxFrontendClasspathTest 类断言失败）。
                        生命周期里 initialize < process-resources < prepare-package 是固定顺序，不依赖同一
                        phase 内的插件排序。
                     ② prepare-package：npm install / npm run build 刚重建完 dist，再拷一次，
                        保证打出的 jar 里是本次构建的前端产物而不是上一次编译留下的旧 dist。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>copy-console-dist-on-compile</id>
                            <phase>process-resources</phase>
                            <goals><goal>copy-resources</goal></goals>
                            <configuration>
                                <outputDirectory>${project.build.outputDirectory}/magic-editor/plugins</outputDirectory>
                                <resources>
                                    <resource>
                                        <directory>src/console/dist</directory>
                                        <filtering>false</filtering>
                                    </resource>
                                </resources>
                            </configuration>
                        </execution>
                        <execution>
                            <id>copy-console-dist</id>
                            <phase>prepare-package</phase>
                            <goals><goal>copy-resources</goal></goals>
                            <configuration>
                                <outputDirectory>${project.build.outputDirectory}/magic-editor/plugins</outputDirectory>
                                <resources>
                                    <resource>
                                        <directory>src/console/dist</directory>
                                        <filtering>false</filtering>
                                    </resource>
                                </resources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 清理上一轮构建遗留的前端产物。vite 每次 build 都会生成新的 hash 文件名（index.<hash>.js），
                 而 copy-resources 只做覆盖、不删除已不存在的旧文件，导致 target/classes/magic-editor
                 以及最终打出的 jar 里堆积多份历史产物。这里在 initialize 阶段先清空该目录，
                 让本次构建的 dist 成为唯一来源。
                 excludeDefaultDirectories=true 保证只删下面显式列出的目录，不会连带删掉整个 target。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>clean-stale-console-assets</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}/magic-editor</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                    <!-- mvn clean 时同步删除源码内的前端构建产物 src/console/dist，避免 dist 残留在工作区 -->
                    <execution>
                        <id>clean-console-dist</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>src/console/dist</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>com.xiongx9527.fw.plus.boot</groupId>
            <artifactId>fw-plus-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ssssssss</groupId>
            <artifactId>magic-api</artifactId>
        </dependency>
    </dependencies>
</project>
