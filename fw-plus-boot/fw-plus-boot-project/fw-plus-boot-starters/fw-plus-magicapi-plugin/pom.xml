<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xiongx9527.fw.plus.boot</groupId>
        <artifactId>fw-plus-boot-starters</artifactId>
        <version>${revision}</version>
    </parent>
    <packaging>pom</packaging>
    <modules>
        <module>fw-plus-magicapi-plugin-freemarker</module>
        <module>fw-plus-magicapi-plugin-config</module>
        <module>fw-plus-magicapi-plugin-rocketmq</module>
        <module>fw-plus-magicapi-plugin-rabbitmq</module>
        <module>fw-plus-magicapi-plugin-kafka</module>
        <module>fw-plus-magicapi-plugin-pulsar</module>
        <module>fw-plus-magicapi-plugin-vue3</module>
        <module>fw-plus-magicapi-plugin-druid</module>
        <module>fw-plus-magicapi-plugin-swagger</module>
        <module>fw-plus-magicapi-plugin-admin</module>
        <module>fw-plus-magicapi-plugin-debezium</module>
        <module>fw-plus-magicapi-plugin-db</module>
        <module>fw-plus-magicapi-plugin-redis</module>
        <module>fw-plus-magicapi-plugin-mongo</module>
        <module>fw-plus-magicapi-plugin-s3</module>
        <module>fw-plus-magicapi-plugin-task</module>
        <module>fw-plus-magicapi-plugin-ws</module>
        <module>fw-plus-magicapi-plugin-dtp</module>
        <module>fw-plus-magicapi-plugin-mqtt-server</module>
        <module>fw-plus-magicapi-plugin-influx</module>
        <module>fw-plus-magicapi-plugin-elasticsearch</module>
        <module>fw-plus-magicapi-plugin-satoken</module>
        <module>fw-plus-magicapi-plugin-mcp</module>
        <module>fw-plus-magicapi-plugin-mqtt-client</module>
        <module>fw-plus-magicapi-plugin-word</module>
        <module>fw-plus-magicapi-plugin-java-entity</module>
        <module>fw-plus-magicapi-plugin-spring-bean</module>
        <module>fw-plus-magicapi-plugin-mybatisplus</module>
        <module>fw-plus-magicapi-plugin-mybatisflex</module>
    </modules>

    <artifactId>fw-plus-magicapi-plugin</artifactId>
    <properties>
        <main.basedir>${basedir}/../../..</main.basedir>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 前端 console 构建（npm install + npm run build），在 prepare-package 阶段执行，mvn compile 不触发前端构建 -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>npm-install</id>
                            <phase>prepare-package</phase>
                            <goals><goal>exec</goal></goals>
                            <configuration>
                                <workingDirectory>${project.basedir}/src/console</workingDirectory>
                                <executable>npm</executable>
                                <arguments>
                                    <argument>install</argument>
                                </arguments>
                            </configuration>
                        </execution>
                        <execution>
                            <id>npm-build</id>
                            <phase>prepare-package</phase>
                            <goals><goal>exec</goal></goals>
                            <configuration>
                                <workingDirectory>${project.basedir}/src/console</workingDirectory>
                                <executable>npm</executable>
                                <arguments>
                                    <argument>run</argument>
                                    <argument>build</argument>
                                </arguments>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!-- 复制前端构建产物到 resources 目录（prepare-package 阶段，赶在 process-resources 的默认资源拷贝之前） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>copy-console-dist</id>
                            <phase>prepare-package</phase>
                            <goals><goal>copy-resources</goal></goals>
                            <configuration>
                                <outputDirectory>${project.build.outputDirectory}/magic-editor/plugins</outputDirectory>
                                <resources>
                                    <resource>
                                        <directory>src/console/dist</directory>
                                        <filtering>false</filtering>
                                    </resource>
                                </resources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <dependencies>
        <dependency>
            <groupId>com.xiongx9527.fw.plus.boot</groupId>
            <artifactId>fw-plus-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xiongx9527.fw.plus.boot</groupId>
            <artifactId>fw-plus-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ssssssss</groupId>
            <artifactId>magic-api</artifactId>
        </dependency>
    </dependencies>
</project>
