<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiongx9527.fw.plus.graph.nebula.jdbc.framework.PlayerMapper">
	<resultMap id="playerMap" type="com.xiongx9527.fw.plus.graph.nebula.jdbc.framework.PlayerRecord">
		<result property="playerName" column="player_name"/>
		<result property="age" column="age"/>
	</resultMap>

	<select id="selectById" resultType="com.xiongx9527.fw.plus.graph.nebula.jdbc.framework.PlayerRecord">
		SELECT name AS playerName, age FROM player WHERE id = #{id}
	</select>

	<select id="selectByIdWithResultMap" resultMap="playerMap">
		SELECT name AS player_name, age FROM player WHERE id = #{id}
	</select>
</mapper>
