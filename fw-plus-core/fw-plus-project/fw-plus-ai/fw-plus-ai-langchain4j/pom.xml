<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xiongx9527.fw.plus</groupId>
        <artifactId>fw-plus-ai-langchain4j-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../fw-plus-ai-langchain4j-parent/pom.xml</relativePath>
    </parent>
    <groupId>com.xiongx9527.fw.plus</groupId>
    <artifactId>fw-plus-ai-langchain4j</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>
    <properties>
        <main.basedir>${basedir}/../../..</main.basedir>
    </properties>
    <dependencies>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
            <scope>compile</scope>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>dev.langchain4j</groupId>
                    <artifactId>langchain4j-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-langchain4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <executions combine.self="override"/>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>default</id>
                        <phase>none</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>__disabled__</include>
                                </includes>
                            </artifactSet>
                            <transformers/>
                        </configuration>
                    </execution>
                    <execution>
                        <id>shade-langchain4j-owner</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>dev.langchain4j:langchain4j</include>
                                </includes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>dev.langchain4j:langchain4j</artifact>
                                    <excludes>
                                        <exclude>dev/langchain4j/service/AiServiceContext.class</exclude>
                                        <exclude>dev/langchain4j/service/AiServices.class</exclude>
                                        <exclude>dev/langchain4j/service/DefaultAiServices.class</exclude>
                                        <exclude>dev/langchain4j/service/DefaultAiServices$1.class</exclude>
                                        <exclude>dev/langchain4j/service/TokenStream.class</exclude>
                                        <exclude>dev/langchain4j/service/tool/ToolExecution.class</exclude>
                                        <exclude>dev/langchain4j/service/tool/ToolExecution$Builder.class</exclude>
                                        <exclude>dev/langchain4j/service/tool/ToolExecution$1.class</exclude>
                                        <exclude>dev/langchain4j/service/TypeUtils.class</exclude>
                                        <exclude>dev/langchain4j/service/tool/ToolExecutor.class</exclude>
                                        <exclude>dev/langchain4j/service/tool/DefaultToolExecutor.class</exclude>
                                        <exclude>dev/langchain4j/service/tool/ToolProvider.class</exclude>
                                        <exclude>dev/langchain4j/service/tool/ToolProviderRequest.class</exclude>
                                        <exclude>dev/langchain4j/service/tool/ToolProviderResult.class</exclude>
                                        <exclude>dev/langchain4j/service/tool/ToolProviderResult$Builder.class</exclude>
                                        <exclude>dev/langchain4j/service/ModerationException.class</exclude>
                                        <exclude>dev/langchain4j/service/Result.class</exclude>
                                        <exclude>dev/langchain4j/service/Result$ResultBuilder.class</exclude>
                                        <exclude>dev/langchain4j/service/output/ServiceOutputParser.class</exclude>
                                        <exclude>dev/langchain4j/service/AiServiceTokenStream.class</exclude>
                                        <exclude>dev/langchain4j/service/AiServiceStreamingResponseHandler.class</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>test-jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
