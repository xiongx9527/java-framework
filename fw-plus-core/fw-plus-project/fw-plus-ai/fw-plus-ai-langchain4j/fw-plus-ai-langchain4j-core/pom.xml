<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xiongx9527.fw.plus</groupId>
        <artifactId>fw-plus-ai-langchain4j</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>fw-plus-ai-langchain4j-core</artifactId>
    <dependencies>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>${langchain4j.version}</version>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <executions combine.self="override"/>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>default</id>
                        <phase>none</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>__disabled__</include>
                                </includes>
                            </artifactSet>
                            <transformers/>
                        </configuration>
                    </execution>
                    <execution>
                        <id>shade-langchain4j-core-owner</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>dev.langchain4j:langchain4j-core</include>
                                </includes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>dev.langchain4j:langchain4j-core</artifact>
                                    <excludes>
                                        <exclude>dev/langchain4j/internal/ValidationUtils.class</exclude>
                                        <exclude>dev/langchain4j/internal/Utils.class</exclude>
                                        <exclude>dev/langchain4j/model/chat/listener/ChatModelRequestContext.class</exclude>
                                        <exclude>dev/langchain4j/model/chat/listener/ChatModelErrorContext.class</exclude>
                                        <exclude>dev/langchain4j/model/chat/listener/ChatModelResponseContext.class</exclude>
                                        <exclude>dev/langchain4j/spi/ServiceHelper.class</exclude>
                                        <exclude>dev/langchain4j/agent/tool/P.class</exclude>
                                        <exclude>dev/langchain4j/agent/tool/ToolSpecification.class</exclude>
                                        <exclude>dev/langchain4j/agent/tool/ToolSpecification$Builder.class</exclude>
                                        <exclude>dev/langchain4j/data/message/ToolExecutionResultMessage.class</exclude>
                                        <exclude>dev/langchain4j/agent/tool/Tool.class</exclude>
                                        <exclude>dev/langchain4j/agent/tool/ToolSpecifications.class</exclude>
                                        <exclude>dev/langchain4j/data/message/UserMessage.class</exclude>
                                        <exclude>dev/langchain4j/data/message/AiMessage.class</exclude>
                                        <exclude>dev/langchain4j/model/chat/request/ChatRequest.class</exclude>
                                        <exclude>dev/langchain4j/model/chat/request/ChatRequest$Builder.class</exclude>
                                        <exclude>dev/langchain4j/model/chat/response/ChatResponse.class</exclude>
                                        <exclude>dev/langchain4j/model/chat/response/ChatResponse$Builder.class</exclude>
                                        <exclude>dev/langchain4j/memory/ChatMemory.class</exclude>
                                        <exclude>dev/langchain4j/rag/query/Metadata.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>test-jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>core-overlay-packaging-it</id>
                        <phase>integration-test</phase>
                        <goals><goal>integration-test</goal></goals>
                        <configuration>
                            <includes>
                                <include>**/CoreOverlayPackagingIT.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>core-overlay-packaging-verify</id>
                        <phase>verify</phase>
                        <goals><goal>verify</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
