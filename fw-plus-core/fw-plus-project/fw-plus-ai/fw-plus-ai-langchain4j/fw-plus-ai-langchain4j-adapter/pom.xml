<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xiongx9527.fw.plus</groupId>
        <artifactId>fw-plus-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../../fw-plus-parent</relativePath>
    </parent>

    <artifactId>fw-plus-ai-langchain4j-adapter</artifactId>

    <properties>
        <main.basedir>${basedir}/../../../..</main.basedir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-model</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-store-embedding</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-langchain4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          fw-plus-ai-langchain4j-core 通过 shade 把官方 langchain4j-core 的类打进自己 jar，
          shade 只在 package 阶段发生；根 reactor 跑 test 时该模块只提供 target/classes，
          测试拿不到这些类。这里以 test scope 引入官方 core 仅供测试 classpath 使用，
          生产 classpath 仍只走 shaded 版（架构契约按 compile 期依赖判定）。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>${langchain4j.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-langchain4j</artifactId>
            <version>${revision}</version>
        </dependency>

</dependencies>

</project>
