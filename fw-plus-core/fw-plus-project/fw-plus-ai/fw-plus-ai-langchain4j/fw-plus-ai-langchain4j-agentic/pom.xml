<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xiongx9527.fw.plus</groupId>
        <artifactId>fw-plus-ai-langchain4j-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../fw-plus-ai-langchain4j-parent/pom.xml</relativePath>
    </parent>
    <artifactId>fw-plus-ai-langchain4j-agentic</artifactId>
    <properties>
        <main.basedir>${basedir}/../../../..</main.basedir>
        <agentic.aggregate.jar>${main.basedir}/fw-plus-project/fw-plus-ai/fw-plus-ai-langchain4j/target/fw-plus-ai-langchain4j-${revision}.jar</agentic.aggregate.jar>
        <agentic.core.jar>${main.basedir}/fw-plus-project/fw-plus-ai/fw-plus-ai-langchain4j/fw-plus-ai-langchain4j-core/target/fw-plus-ai-langchain4j-core-${revision}.jar</agentic.core.jar>
        <agentic.aggregate.classes>${main.basedir}/fw-plus-project/fw-plus-ai/fw-plus-ai-langchain4j/target/classes</agentic.aggregate.classes>
        <agentic.core.classes>${main.basedir}/fw-plus-project/fw-plus-ai/fw-plus-ai-langchain4j/fw-plus-ai-langchain4j-core/target/classes</agentic.core.classes>
        <agentic.module.root>${project.basedir}</agentic.module.root>
        <agentic.source.root>${project.basedir}/src/main/java</agentic.source.root>
        <agentic.manifest>${project.basedir}/UPSTREAM-MANIFEST.txt</agentic.manifest>
        <agentic.modified.manifest>${project.basedir}/JAVA8-MODIFIED-MANIFEST.txt</agentic.modified.manifest>
        <agentic.allowlist>${project.basedir}/../compat/overlay-allowlist.tsv</agentic.allowlist>
        <agentic.aggregate.surefire.reports>${project.basedir}/../target/surefire-reports</agentic.aggregate.surefire.reports>
        <agentic.core.surefire.reports>${project.basedir}/../fw-plus-ai-langchain4j-core/target/surefire-reports</agentic.core.surefire.reports>
        <agentic.runtime.classpath>${project.build.directory}/agentic-runtime-classpath.txt</agentic.runtime.classpath>
        <agentic.surefire.reports>${project.build.directory}/surefire-reports</agentic.surefire.reports>
        <agentic.jar>${project.build.directory}/${project.build.finalName}.jar</agentic.jar>
        <agentic.official.jar>${user.home}/.m2/repository/dev/langchain4j/langchain4j-agentic/1.19.0-beta29/langchain4j-agentic-1.19.0-beta29.jar</agentic.official.jar>
        <agentic.official.sources>${user.home}/.m2/repository/dev/langchain4j/langchain4j-agentic/1.19.0-beta29/langchain4j-agentic-1.19.0-beta29-sources.jar</agentic.official.sources>
        <agentic.local.classes>${project.build.outputDirectory}</agentic.local.classes>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-langchain4j</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-langchain4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-langchain4j</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-langchain4j-core</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <agentic.official.jar>${agentic.official.jar}</agentic.official.jar>
                        <agentic.official.sources>${agentic.official.sources}</agentic.official.sources>
                        <agentic.local.classes>${agentic.local.classes}</agentic.local.classes>
                        <agentic.source.root>${agentic.source.root}</agentic.source.root>
                        <agentic.manifest>${agentic.manifest}</agentic.manifest>
                        <agentic.modified.manifest>${agentic.modified.manifest}</agentic.modified.manifest>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>agentic-runtime-classpath</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>build-classpath</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${agentic.runtime.classpath}</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>agentic-runtime-worktree-classpath</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <replace file="${agentic.runtime.classpath}"
                                         token="${settings.localRepository}/com/xiongx9527/fw/plus/fw-plus-ai-langchain4j/${revision}/fw-plus-ai-langchain4j-${revision}.jar"
                                         value="${agentic.aggregate.jar}"/>
                                <replace file="${agentic.runtime.classpath}"
                                         token="${settings.localRepository}/com/xiongx9527/fw/plus/fw-plus-ai-langchain4j-core/${revision}/fw-plus-ai-langchain4j-core-${revision}.jar"
                                         value="${agentic.core.jar}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <agentic.module.root>${agentic.module.root}</agentic.module.root>
                        <agentic.source.root>${agentic.source.root}</agentic.source.root>
                        <agentic.manifest>${agentic.manifest}</agentic.manifest>
                        <agentic.allowlist>${agentic.allowlist}</agentic.allowlist>
                        <agentic.aggregate.jar>${agentic.aggregate.jar}</agentic.aggregate.jar>
                        <agentic.core.jar>${agentic.core.jar}</agentic.core.jar>
                        <agentic.aggregate.classes>${agentic.aggregate.classes}</agentic.aggregate.classes>
                        <agentic.core.classes>${agentic.core.classes}</agentic.core.classes>
                        <agentic.runtime.classpath>${agentic.runtime.classpath}</agentic.runtime.classpath>
                        <agentic.surefire.reports>${agentic.surefire.reports}</agentic.surefire.reports>
                        <agentic.aggregate.surefire.reports>${agentic.aggregate.surefire.reports}</agentic.aggregate.surefire.reports>
                        <agentic.core.surefire.reports>${agentic.core.surefire.reports}</agentic.core.surefire.reports>
                        <agentic.jar>${agentic.jar}</agentic.jar>
                    </systemPropertyVariables>
                </configuration>
                <executions combine.self="override">
                    <execution>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>agentic-integration-test</id>
                        <phase>integration-test</phase>
                        <goals combine.self="override">
                            <goal>integration-test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/AgenticOverlayPackagingIT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <agentic.module.root>${agentic.module.root}</agentic.module.root>
                                <agentic.source.root>${agentic.source.root}</agentic.source.root>
                                <agentic.manifest>${agentic.manifest}</agentic.manifest>
                                <agentic.allowlist>${agentic.allowlist}</agentic.allowlist>
                                <agentic.aggregate.jar>${agentic.aggregate.jar}</agentic.aggregate.jar>
                                <agentic.core.jar>${agentic.core.jar}</agentic.core.jar>
                                <agentic.aggregate.classes>${agentic.aggregate.classes}</agentic.aggregate.classes>
                                <agentic.core.classes>${agentic.core.classes}</agentic.core.classes>
                                <agentic.runtime.classpath>${agentic.runtime.classpath}</agentic.runtime.classpath>
                                <agentic.surefire.reports>${agentic.surefire.reports}</agentic.surefire.reports>
                                <agentic.aggregate.surefire.reports>${agentic.aggregate.surefire.reports}</agentic.aggregate.surefire.reports>
                                <agentic.core.surefire.reports>${agentic.core.surefire.reports}</agentic.core.surefire.reports>
                                <agentic.jar>${agentic.jar}</agentic.jar>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>agentic-verify</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
