# Module-level Lombok configuration for fw-plus-ai-askdata.
# Make generated builder nested classes named `Builder` (not `XxxBuilder`),
# matching the hand-written builder convention used in fw-plus-ai-base and the
# consumer code in this module (e.g. `AskDataInput.Builder b = AskDataInput.builder()`).
# Scoped here so it does not affect other modules (e.g. langchain4j copies that
# already define their own nested `Builder` classes).
config.stopBubbling = true
lombok.builder.className = Builder
