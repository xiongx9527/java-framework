<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!--
	<parent>
		<groupId>com.xiongx9527.fw</groupId>
		<artifactId>framework-parent</artifactId>
		<version>0.2.2-SNAPSHOT</version>
		<relativePath />
	</parent>
    -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.18</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<packaging>pom</packaging>
	<modules>
		<module>fw-plus-project</module>
	</modules>
	<groupId>com.xiongx9527.fw.plus</groupId>
	<artifactId>fw-plus-build</artifactId>
	<version>${revision}</version>
	<name>Fw-Plus Build</name>
	<properties>
		<revision>0.1.1-SNAPSHOT</revision>
		<jdk.version>1.8</jdk.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.encoding>UTF-8</maven.compiler.encoding>
		<maven-compiler-plugin.version>3.10.1</maven-compiler-plugin.version>
		<cobertura-maven-plugin.version>2.7</cobertura-maven-plugin.version>
		<flatten-maven-plugin.version>1.3.0</flatten-maven-plugin.version>
	</properties>
	<description>
		fw-plus 核心库管理.
	</description>
	<!--协议-->
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>
	<!--开发者信息
	<developers>
		<developer>
			<id>jugui-tech nanchang group</id>
			<name>巨龟科技南昌团队</name>
			<organization>jugui-tech</organization>
			<organizationUrl>https://gitee.com/jugui-tech</organizationUrl>
			<email>xiongxiao@jugui-tech.com</email>
		</developer>
	</developers>
	-->
	<!--
	配置拉取仓库地址
	<repositories>
		<repository>
			<id>jugui-snapshot</id>
			<url>http://172.17.1.6:28081/repository/jugui-snapshot/</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>jugui-release</id>
			<url>http://172.17.1.6:28081/repository/jugui-release/</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>
    发布仓库地址
	<distributionManagement>
		<repository>
			<id>jugui-release</id>
			<url>http://172.17.1.6:28081/repository/jugui-release/</url>
		</repository>
		<snapshotRepository>
			<id>jugui-snapshot</id>
			<url>http://172.17.1.6:28081/repository/jugui-snapshot/</url>
		</snapshotRepository>
	</distributionManagement>
	-->
	<!--编译插件-->
	<build>
		<plugins>
			<!--jdk version-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven-compiler-plugin.version}</version>
				<configuration>
					<source>${jdk.version}</source>
					<target>${jdk.version}</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>cobertura-maven-plugin</artifactId>
				<version>${cobertura-maven-plugin.version}</version>
				<configuration>
					<formats>
						<format>html</format>
						<format>xml</format>
					</formats>
					<check />
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>${flatten-maven-plugin.version}</version>
				<inherited>true</inherited>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
						<configuration>
							<!-- 避免IDE将 .flattened-pom.xml 自动识别为功能模块 -->
							<updatePomFile>true</updatePomFile>
							<flattenMode>resolveCiFriendliesOnly</flattenMode>
							<pomElements>
								<parent>expand</parent>
								<distributionManagement>remove</distributionManagement>
								<repositories>remove</repositories>
							</pomElements>
						</configuration>
					</execution>
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
