<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xiongx9527.fw.plus.ai</groupId>
        <artifactId>fw-plus-ai-build</artifactId>
        <version>${revision}</version>
        <relativePath>../../fw-plus-ai/pom.xml</relativePath>
    </parent>
    <packaging>pom</packaging>
    <modules>
        <module>fw-plus-ai-magicapi-sample</module>
        <module>fw-plus-ai-mcp-server-sample</module>
        <module>fw-plus-ai-chat-sample</module>
        <module>fw-plus-ai-agentscope-sample</module>
        <module>fw-plus-ai-nl2sql-sample</module>
    </modules>
    <version>${revision}</version>
    <artifactId>fw-plus-ai-samples</artifactId>
    <properties>
        <main.basedir>${basedir}/../..</main.basedir>
        <!--跳过test-->
        <maven.test.skip>true</maven.test.skip>
        <!--跳过javadoc生成-->
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <!--跳过install-->
        <maven.install.skip>true</maven.install.skip>
        <!--跳过deploy-->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>
    <dependencyManagement>
        <dependencies>

            <!-- 先 import AI 层 BOM：其内部已 import fw-plus-boot-dependencies，
                 且在本层钉住 reactor-core / jackson / opentelemetry（AgentScope 2.0.4 所需，
                 高于 Boot 3.5.8 默认管理版本）。Maven 同坐标先声明者优先，
                 因此必须置于 fw-plus-boot-dependencies 之前，否则钉住的版本会被 Boot BOM 压回。 -->
            <dependency>
                <groupId>com.xiongx9527.fw.plus.ai</groupId>
                <artifactId>fw-plus-ai-boot-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.xiongx9527.fw.plus.boot</groupId>
                <artifactId>fw-plus-boot-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- swagger
        <dependency>
            <groupId>io.springfox</groupId>
            <artifactId>springfox-boot-starter</artifactId>
        </dependency>
         -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.xiongx9527.fw.plus.ai</groupId>
            <artifactId>fw-plus-ai-boot-starter</artifactId>
        </dependency>

    </dependencies>

</project>
